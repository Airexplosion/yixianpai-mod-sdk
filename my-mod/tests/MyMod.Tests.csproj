<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- 目标 net8.0，但允许在更高的运行时（.NET 9/10 ...）上跑 -->
    <RollForward>Major</RollForward>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS1701;CS1702</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- 不用 ProjectReference 引用 src（那是 net40 游戏内程序集）：直接把入口源码编进来，用 netstandard2.0 的 Core 在 net8 下测。
         这里没有定义 YX_GAME，所以 #if YX_GAME 里的代码不会编进测试。 -->
    <Compile Include="..\src\**\*.cs" Link="src\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Yx.ModSdk.Core"><HintPath>$(YxSdkDir)netstandard2.0\Yx.ModSdk.Core.dll</HintPath></Reference>
    <Reference Include="Yx.ModSdk.Testing"><HintPath>$(YxSdkDir)netstandard2.0\Yx.ModSdk.Testing.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <Target Name="CheckSdk" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(YxSdkDir)netstandard2.0\Yx.ModSdk.Testing.dll')" Text="找不到 SDK 测试 DLL（YxSdkDir=$(YxSdkDir)）：确认仓库自带的 sdk/ 目录在，或设置 YX_SDK_DIR" />
  </Target>
</Project>
